# ── agent-scrum-kit · configuration ────────────────────────────────────────────
# Copy this file to kit.env and fill it in. kit.env is gitignored.
# All project knowledge stands HERE, nowhere else. No script knows your project.
# Instructions: INSTALL.md

# --- project -------------------------------------------------------------------
# The repo the tickets and pull requests live in. Format: <owner>/<repo>.
KIT_REPO="UNKNOWN — ask the owner, e.g. my-org/my-repo"

# Root of the worktree the roles work in (an absolute path).
KIT_WORKTREE_ROOT="$HOME/Developer/my-project"

# The integration branch. No agent works on it directly.
KIT_BASE_BRANCH="development"

# --- ticket backend ------------------------------------------------------------
# "gh"   -> real GitHub via the gh CLI
# "file" -> a local JSON file, for the eval suite and dry runs without a network
KIT_ISSUE_BACKEND="gh"
KIT_ISSUE_FILE=".kit-issues.json"     # only with KIT_ISSUE_BACKEND=file

# --- status model --------------------------------------------------------------
# Key for bin/status.sh | name of the option in the status field of the project board.
# The order is the forward edge. The keys are protocol (protocols/LOOP.md) and
# are not renamed; the board names you may adapt to your board.
KIT_STATUS_MAP="
backlog|Backlog
planned|Planned
in-progress|In progress
rfr|RfR
in-review|In review
rft|RfT
in-testing|In Testing
done|Done
"

KIT_LABEL_PREFIX="status:"      # mirror label on the issue, exactly one at a time
KIT_OWNER_PREFIX="owner:"       # who holds a ticket — NOT the assignee (one account for everybody)
KIT_SPRINT_LABEL="sprint:current"

# --- project board -------------------------------------------------------------
# "github-project" -> the status field of a GitHub Project (v2) is the truth, the label
#                     only a mirror. bin/board-check.sh --write fetches the IDs into board.env.
# "none"           -> labels only.
KIT_BOARD="none"
KIT_PROJECT_OWNER="UNKNOWN — the login or org the project belongs to"
KIT_PROJECT_NUMBER="UNKNOWN — the number from the project URL .../projects/<number>"

# --- cast ----------------------------------------------------------------------
# Four eyes in round robin: an engineer builds its own ticket and reviews a foreign one, wearing
# all four hats — QA, simplicity, security, acceptance. It never reviews what it built; status.sh
# turns the builder away at in-review, rft and in-testing.
# The hats used to be five own roles (qa-ruthless, simplicity-reviewer, security-engineer,
# acceptance-tester, merge-gate). Their job descriptions stay in roles/ as the handbook per hat.
KIT_ROLES="product-owner requirements-engineer engineer-a engineer-b engineer-c watchdog kit-maintainer"

# Which states a role picks up. Empty = picks up no tickets. * = sees everything.
# Every engineer sees planned (to build) and rfr, in-review, rft, in-testing (to review a foreign
# ticket). Which of those tickets is its own, the gate decides — not the queue.
KIT_QUEUE_MAP="
product-owner|*
requirements-engineer|backlog
engineer-a|planned,rfr,in-review,rft,in-testing
engineer-b|planned,rfr,in-review,rft,in-testing
engineer-c|planned,rfr,in-review,rft,in-testing
watchdog|
kit-maintainer|
"

# --- cadence of the watchdog loop ------------------------------------------------
# Before every model start the loop runs bin/tick.sh --signal. If nothing is waiting, it starts
# no model but waits: up to KIT_TICK_INTERVAL seconds, in steps of KIT_TICK_POLL.
# A status change creates a wake mark under .role-loop/<role>.wake and ends the waiting at once.
KIT_TICK_INTERVAL=300
KIT_TICK_POLL=10

# --- sprint --------------------------------------------------------------------
KIT_SPRINT_TICKETS=6          # tickets per sprint
KIT_MIN_PLANNED=7             # this many tickets the product-owner keeps planned ahead
KIT_QUEUE_STOP=2              # from this length of the review or test queue they plan nothing new
KIT_TICKET_MINUTES=30         # cadence per ticket

# --- token budget --------------------------------------------------------------
# Context size = the largest input state of ONE turn, not the sum.
KIT_WARN_TOKENS=250000        # from here on: take no new ticket
KIT_STOP_TOKENS=300000        # from here on: clear the context at the ticket boundary
KIT_MAX_TICKETS=5             # the emergency brake, in force even without a watchdog

# --- requirements ----------------------------------------------------------------
# Where existing knowledge about the project lives (documentation, decisions, earlier ticket knowledge).
# The requirements-engineer reads here before writing intent.md and spec.md. Empty = there is none.
KIT_REQUIREMENTS_DIR=""
# The command that opens or checks the reference to compare against (for example an existing application the
# result must match). The requirements-engineer runs it in THEIR session, never as a subagent,
# and records the finding as the line "REFERENCE: <what, when>" in the spec.md. If the key is set,
# planned refuses a spec.md without that line. Empty = no reference, no obligation.
KIT_REFERENCE_CMD=""

# --- gates ---------------------------------------------------------------------
# Time limit per gate in seconds for bin/gates.sh run. A gate that exceeds it is red.
KIT_GATE_TIMEOUT=600

# --- host ----------------------------------------------------------------------
# Which adapter under adapters/<host>/ applies. See adapters/README.md.
KIT_HOST="claude-code"

# --- local model (hosts qwen-code and pi) ---------------------------------------
# OpenAI-compatible endpoint of a local runtime, e.g. Ollama: http://127.0.0.1:11434/v1
KIT_LOCAL_BASE_URL=""
# Your choice after bin/local-model-check.sh: only a model with "tool calls: yes" can run bin/*.sh.
# The kit picks nothing. A "tools" badge is not a measurement.
KIT_LOCAL_MODEL=""
# Seconds per test request; the first request loads the model.
KIT_LOCAL_CHECK_TIMEOUT=600

# How long a lease (the twin lock per role) stays valid without a tick, in minutes.
KIT_LEASE_MINUTES=20
