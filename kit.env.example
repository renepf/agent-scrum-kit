# ── agent-scrum-kit · Konfiguration ────────────────────────────────────────────
# Kopiere diese Datei nach kit.env und fuelle sie aus. kit.env ist gitignored.
# Alles Projektwissen steht HIER, nirgends sonst. Kein Skript kennt dein Projekt.

# --- Projekt -------------------------------------------------------------------
# Das Repo, in dem die Tickets liegen. Format: <org>/<repo>.
KIT_REPO="UNKNOWN — beim Owner erfragen, z.B. meine-org/mein-repo"

# Wurzel des Arbeitsbaums, in dem die Rollen arbeiten (absoluter Pfad).
KIT_WORKTREE_ROOT="$HOME/Developer/mein-projekt"

# Integrationsbranch. Kein Agent arbeitet direkt darauf.
KIT_BASE_BRANCH="development"

# --- Ticketstatus --------------------------------------------------------------
# Praefix der Status-Labels am Issue. Genau ein Label haengt zu jeder Zeit.
KIT_LABEL_PREFIX="status:"

# Erlaubte Zustaende, in Reihenfolge der Vorwaertskante.
KIT_STATES="open planned in-progress rfr in-review rft"

# Label, das die Tickets des aktiven Sprints markiert.
KIT_SPRINT_LABEL="sprint:current"

# Woher der Ticketstatus kommt: "gh" (echtes GitHub) oder "file" (lokale JSON-Datei).
# "file" ist fuer die Eval-Suite und fuer Trockenlaeufe ohne Netz.
KIT_ISSUE_BACKEND="gh"
KIT_ISSUE_FILE=".kit-issues.json"     # nur bei KIT_ISSUE_BACKEND=file

# --- Cast ----------------------------------------------------------------------
# Die Rollen, die es gibt. Jede braucht eine Datei roles/<rolle>.md
# (coder-a und coder-b teilen sich roles/engineer.md).
KIT_ROLES="product-owner engineer-a engineer-b qa-ruthless simplicity-reviewer security-engineer acceptance-tester merge-gate watchdog"

# --- Sprint --------------------------------------------------------------------
KIT_SPRINT_TICKETS=6          # Tickets je Sprint
KIT_TICKET_MINUTES=30         # Takt je Ticket

# --- Tokenbudget ---------------------------------------------------------------
# Kontextgroesse = groesster Eingabestand EINES Turns, nicht die Summe.
KIT_WARN_TOKENS=250000        # ab hier: kein neues Ticket mehr annehmen
KIT_STOP_TOKENS=300000        # ab hier: an der Ticketgrenze /clear
KIT_MAX_TICKETS=5             # Notbremse, gilt auch ohne Watchdog

# --- Host ----------------------------------------------------------------------
# Welcher Adapter unter adapters/<host>/ gilt. Siehe adapters/README.md.
KIT_HOST="claude-code"
