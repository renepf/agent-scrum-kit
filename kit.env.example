# ── agent-scrum-kit · Konfiguration ────────────────────────────────────────────
# Kopiere diese Datei nach kit.env und fuelle sie aus. kit.env ist gitignored.
# Alles Projektwissen steht HIER, nirgends sonst. Kein Skript kennt dein Projekt.
# Anleitung: INSTALL.md

# --- Projekt -------------------------------------------------------------------
# Das Repo, in dem Tickets und Pull Requests liegen. Format: <owner>/<repo>.
KIT_REPO="UNKNOWN — beim Owner erfragen, z.B. meine-org/mein-repo"

# Wurzel des Arbeitsbaums, in dem die Rollen arbeiten (absoluter Pfad).
KIT_WORKTREE_ROOT="$HOME/Developer/mein-projekt"

# Integrationsbranch. Kein Agent arbeitet direkt darauf.
KIT_BASE_BRANCH="development"

# --- Ticket-Backend ------------------------------------------------------------
# "gh"   -> echtes GitHub via gh CLI
# "file" -> lokale JSON-Datei, fuer die Eval-Suite und Trockenlaeufe ohne Netz
KIT_ISSUE_BACKEND="gh"
KIT_ISSUE_FILE=".kit-issues.json"     # nur bei KIT_ISSUE_BACKEND=file

# --- Statusmodell --------------------------------------------------------------
# Schluessel fuer bin/status.sh | Name der Option im Status-Feld des Project-Boards.
# Reihenfolge = Vorwaertskante. Die Schluessel sind Protokoll (protocols/LOOP.md) und
# werden nicht umbenannt; die Board-Namen darfst du an dein Board anpassen.
KIT_STATUS_MAP="
backlog|Backlog
planned|Planned
in-progress|In progress
rfr|RfR
in-review|In review
rft|RfT
in-testing|In Testing
done|Done
"

KIT_LABEL_PREFIX="status:"      # Spiegel-Label am Issue, genau eines zur Zeit
KIT_OWNER_PREFIX="owner:"       # wer ein Ticket haelt — NICHT der Assignee (ein Account fuer alle)
KIT_SPRINT_LABEL="sprint:current"

# --- Project-Board -------------------------------------------------------------
# "github-project" -> das Status-Feld eines GitHub Projects (v2) ist die Wahrheit, das Label
#                     nur ein Spiegel. IDs holt bin/board-check.sh --write nach board.env.
# "none"           -> nur Labels.
KIT_BOARD="none"
KIT_PROJECT_OWNER="UNKNOWN — Login oder Org, der das Project gehoert"
KIT_PROJECT_NUMBER="UNKNOWN — Nummer aus der Project-URL .../projects/<nummer>"

# --- Cast ----------------------------------------------------------------------
KIT_ROLES="product-owner requirements-engineer engineer-a engineer-b qa-ruthless simplicity-reviewer security-engineer acceptance-tester merge-gate watchdog kit-maintainer"

# Welche Zustaende eine Rolle aufnimmt. Leer = nimmt keine Tickets auf. * = sieht alle.
KIT_QUEUE_MAP="
product-owner|*
requirements-engineer|backlog
engineer-a|planned
engineer-b|planned
qa-ruthless|rfr,in-review
simplicity-reviewer|rfr,in-review
security-engineer|rfr,in-review
acceptance-tester|rft
merge-gate|in-testing
watchdog|
kit-maintainer|
"

# --- Sprint --------------------------------------------------------------------
KIT_SPRINT_TICKETS=6          # Tickets je Sprint
KIT_MIN_PLANNED=7             # so viele Tickets haelt der product-owner mindestens geplant vor
KIT_QUEUE_STOP=2              # ab dieser Laenge der Pruef- oder Testschlange plant er nichts Neues
KIT_TICKET_MINUTES=30         # Takt je Ticket

# --- Tokenbudget ---------------------------------------------------------------
# Kontextgroesse = groesster Eingabestand EINES Turns, nicht die Summe.
KIT_WARN_TOKENS=250000        # ab hier: kein neues Ticket mehr annehmen
KIT_STOP_TOKENS=300000        # ab hier: an der Ticketgrenze Kontext leeren
KIT_MAX_TICKETS=5             # Notbremse, gilt auch ohne Watchdog

# --- Gates ---------------------------------------------------------------------
# Zeitgrenze je Gate in Sekunden fuer bin/gates.sh run. Ein Gate, das sie ueberschreitet, ist rot.
KIT_GATE_TIMEOUT=600

# --- Host ----------------------------------------------------------------------
# Welcher Adapter unter adapters/<host>/ gilt. Siehe adapters/README.md.
KIT_HOST="claude-code"

# --- Local model (hosts qwen-code and pi) ---------------------------------------
# OpenAI-compatible endpoint of a local runtime, e.g. Ollama: http://127.0.0.1:11434/v1
KIT_LOCAL_BASE_URL=""
# Your choice after bin/local-model-check.sh: only a model with "tool calls: yes" can run bin/*.sh.
# The kit picks nothing. A "tools" badge is not a measurement.
KIT_LOCAL_MODEL=""
# Seconds per test request; the first request loads the model.
KIT_LOCAL_CHECK_TIMEOUT=600

# Wie lange ein Lease (die Zwillingssperre je Rolle) ohne Tick gueltig bleibt, in Minuten.
KIT_LEASE_MINUTES=20
