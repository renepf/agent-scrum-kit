#!/usr/bin/env python3
"""Vorgetaeuschtes gh fuer die Eval-Suite. Kein Netz, eigener Zustand.

Zustand:  $FAKE_GH_STATE  (JSON: {"<nr>": {"labels": [], "assignees": [], "state": "OPEN",
                                         "comments": [], "board": null}})
Protokoll: $FAKE_GH_LOG   (eine Zeile je Aufruf, in Aufrufreihenfolge)
Fehler:   $FAKE_GH_FAIL   "graphql" | "item-edit" | "readback" | "" — laesst genau diesen Aufruf scheitern
Optionen: $FAKE_GH_OPTIONS "o-backlog=Backlog;o-planned=Planned;..." — Namen fuer das Zuruecklesen

Nur die Aufrufe, die bin/preflight.sh und bin/tickets.sh wirklich machen. Alles andere
scheitert laut, damit ein neuer Aufruf im Kit nicht still durchrutscht.
"""
import json, os, sys

args = sys.argv[1:]
state_path = os.environ["FAKE_GH_STATE"]
log_path = os.environ["FAKE_GH_LOG"]
fail = os.environ.get("FAKE_GH_FAIL", "")

with open(state_path, encoding="utf-8") as fh:
    db = json.load(fh)

def log(kind):
    with open(log_path, "a", encoding="utf-8") as fh:
        fh.write(kind + "\n")

def opt(name):
    return args[args.index(name) + 1] if name in args else None

def save():
    tmp = state_path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(db, fh, indent=2, sort_keys=True)
    os.replace(tmp, state_path)

def issue(nr):
    if nr not in db:
        sys.stderr.write(f"GraphQL: Could not resolve to an issue with the number of {nr}.\n")
        sys.exit(1)
    return db[nr]

def die(msg):
    sys.stderr.write(msg + "\n")
    sys.exit(1)

if args[:2] == ["api", "user"]:
    log("api user"); print("eval-bot"); sys.exit(0)

if args[:2] == ["api", "graphql"] and any("fieldValueByName" in a for a in args):
    # Zuruecklesen des Status-Feldes nach item-edit (bin/tickets.sh board-set).
    item = [a for a in args if a.startswith("id=")][0][3:]
    log(f"api graphql readback {item}")
    if fail == "readback":
        print("")          # Board zeigt nichts: tickets.sh muss nach 4 Versuchen abbrechen
        sys.exit(0)
    names = dict(kv.split("=", 1) for kv in os.environ.get("FAKE_GH_OPTIONS", "").split(";") if "=" in kv)
    print(names.get(db[item.removeprefix("PVTI_")].get("board") or "", ""))
    sys.exit(0)

if args[:2] == ["api", "graphql"]:
    log("api graphql addProjectV2ItemById")
    if fail == "graphql":
        die("HTTP 502: Bad Gateway (https://api.github.com/graphql)")
    content = [a for a in args if a.startswith("c=")][0][2:]
    print("PVTI_" + content.removeprefix("I_"))
    sys.exit(0)

if args[:2] == ["project", "item-edit"]:
    item, option = opt("--id"), opt("--single-select-option-id")
    log(f"project item-edit {item} {option}")
    if fail == "item-edit":
        die("HTTP 503: Service Unavailable")
    db[item.removeprefix("PVTI_")]["board"] = option
    save(); sys.exit(0)

if args[:1] == ["issue"] and len(args) >= 3:
    sub, nr = args[1], args[2]
    i = issue(nr)
    if sub == "view":
        field = opt("--json")
        log(f"issue view {nr} {field}")
        if field == "labels":      print("\n".join(i["labels"]))
        elif field == "assignees": print("\n".join(i["assignees"]))
        elif field == "id":        print("I_" + nr)
        elif field == "state":     print(i["state"])
        elif field == "title":     print(i.get("title", ""))
        elif field == "comments":  print(json.dumps(i["comments"]))
        else: die(f"fake-gh: --json {field} nicht nachgebildet")
        sys.exit(0)
    if sub == "edit":
        for flag, key, add in (("--add-label", "labels", True), ("--remove-label", "labels", False),
                               ("--add-assignee", "assignees", True), ("--remove-assignee", "assignees", False)):
            val = opt(flag)
            if val is None:
                continue
            log(f"issue edit {nr} {flag} {val}")
            if add and val not in i[key]:
                i[key].append(val)
            if not add:
                i[key] = [v for v in i[key] if v != val]
        save(); sys.exit(0)
    if sub == "comment":
        log(f"issue comment {nr}"); i["comments"].append(opt("--body")); save(); sys.exit(0)
    if sub == "close":
        log(f"issue close {nr}"); i["state"] = "CLOSED"; save(); sys.exit(0)

die("fake-gh: Aufruf nicht nachgebildet: gh " + " ".join(args))
