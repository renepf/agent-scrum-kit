{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/adapters/claude-code/session-start.sh",
            "timeout": 10,
            "statusMessage": "agent-scrum-kit: Rollenanker"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/adapters/claude-code/session-start.sh --wake",
            "asyncRewake": true,
            "timeout": 30
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "0",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "0"
  }
}
